# Identity is read from the existing bridge using VOICE_BRIDGE_ENV_FILE.
# Set VOICE_CONFIG_FILE to this file's absolute path.
VOICE_GUILD_ID=
VOICE_CHANNEL_ID=
VOICE_TRANSCRIPT_CHANNEL_ID=
VOICE_DATA_DIR=/absolute/path/to/private/voice-data
VOICE_PYTHON=/usr/bin/python3
VOICE_MODEL=base.en
VOICE_RETENTION_DAYS=30

# Spoken commands (optional, off by default). With this on, the owner can say
# "put this in the <name> thread <instruction>" and it is delivered to that
# session as their own words. Transcription alone never needs these.
VOICE_CONTROL_ENABLED=false
CCDB_API_URL=http://127.0.0.1:8080
CCDB_API_SECRET=
